{
  "expo": {
    "name": "HydroSmart",
    "slug": "hydrosmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "scheme": "hydrosmart",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hydrosmart.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access not needed",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.hydrosmart.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#00D4FF",
          "defaultChannel": "hydrosmart-reminders",
          "sounds": [
            "./assets/notification_sound.wav"
          ]
        }
      ],
      "expo-font",
      "./split-apk-plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdda0ae4-b34c-4ada-91cb-c26685959cfa"
      }
    }
  }
}
